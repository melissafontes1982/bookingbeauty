# Copie para .env.local para desenvolver localmente. No Vercel, defina estas
# variáveis em Project Settings > Environment Variables (Production, Preview e Development).

# --- Supabase (Project Settings > API) ---
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SECRETA: nunca com prefixo VITE_ e nunca no GitHub
SUPABASE_SERVICE_ROLE_KEY=

# --- Notificações push (opcional; gerar com: npm run vapid) ---
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- IA: tradução de serviços e recomendador (opcional) ---
AI_API_KEY=
AI_PROVIDER=anthropic
# AI_MODEL=claude-haiku-5-5
# Para OpenAI: AI_PROVIDER=openai, AI_MODEL=<nome do modelo> e (opcional) AI_BASE_URL
